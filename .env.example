# ---------------------------------------------------------------------------
# CORE
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
CORS_ORIGINS="http://localhost:3000"

# PostgreSQL (must have the `vector` extension available — use the
# `pgvector/pgvector` docker image, see docker-compose.yml)
DATABASE_URL="postgresql://platform:platform@localhost:5432/platform?schema=public"

# Redis (queues + cache)
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Encryption key used to encrypt ApiKey.encryptedValue at rest (32 bytes, base64)
APP_ENCRYPTION_KEY="replace-with-32-byte-base64-key"

# Object storage (S3-compatible: AWS S3, Cloudflare R2, MinIO, ...)
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="platform-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---------------------------------------------------------------------------
# AI PROVIDERS (fill in only what you plan to use — the AI Orchestrator
# gracefully falls back to the "mock" provider for anything missing so the
# platform runs end-to-end without any keys set)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
STABILITY_API_KEY=""
REPLICATE_API_TOKEN=""

# ---------------------------------------------------------------------------
# SALES / ANALYTICS INTEGRATIONS (optional — connect what applies)
# ---------------------------------------------------------------------------
SHOPIFY_SHOP_DOMAIN=""
SHOPIFY_ACCESS_TOKEN=""
WOOCOMMERCE_URL=""
WOOCOMMERCE_CONSUMER_KEY=""
WOOCOMMERCE_CONSUMER_SECRET=""
HOTMART_CLIENT_ID=""
HOTMART_CLIENT_SECRET=""
STRIPE_SECRET_KEY=""
META_ADS_ACCESS_TOKEN=""
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ANALYTICS_CREDENTIALS_JSON=""

# ---------------------------------------------------------------------------
# SOCIAL PUBLISHING (optional — required only for Autopublishing module)
# ---------------------------------------------------------------------------
META_APP_ID=""
META_APP_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
